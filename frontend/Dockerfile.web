FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
ARG NOVELFORGE_BUILD_META_B64=""
RUN if [ -n "$NOVELFORGE_BUILD_META_B64" ]; then \
      node scripts/write-build-meta.cjs "$NOVELFORGE_BUILD_META_B64" src/renderer/public/build-meta.json; \
    fi
RUN npm run build:web:container

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget -qO- http://127.0.0.1/healthz/frontend >/dev/null || exit 1
